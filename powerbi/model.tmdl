				changedProperty = DataCategory

				annotation SummarizationSetBy = Automatic

			column MODEL_YEAR
				dataType: double
				formatString: 0
				lineageTag: 800bfd3a-8708-40c7-adfb-fc23a65edcec
				sourceLineageTag: MODEL_YEAR
				summarizeBy: none
				sourceColumn: MODEL_YEAR

				changedProperty = FormatString

				annotation SummarizationSetBy = Automatic

				annotation PBI_FormatHint = {"isDecimal":true}

			column MAKE
				dataType: string
				lineageTag: 451d776e-b7aa-4e43-9ca8-a52fc38d39b7
				sourceLineageTag: MAKE
				summarizeBy: none
				sourceColumn: MAKE

				annotation SummarizationSetBy = Automatic

			column MODEL
				dataType: string
				lineageTag: 4cb20fd2-44b7-4cda-aed5-ea1f4838566e
